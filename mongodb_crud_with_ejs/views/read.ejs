<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>  
    <link rel="stylesheet" href="/stylesheets/style.css"> 
    <title>Document</title>
</head>
<body>
   <div class="w-full min-h-screen bg-zinc-900 px-5 py-3 text-white">
    <div>
        <a class=" text-red-500" href="/">Back to Home</a>
        <!-- <a href="/"></a> -->
    </div>
       <h1 class="tracking-tighter text-3xl text-white">All Users</h1>
       <div class="users flex flex-wrap gap-2 py-3">
        <% if(users.length > 0) { %>
            <% users.forEach(function(user){%>
                <div class="user p-4  max-w-52 bg-zinc-800 rounded-lg">
                <div class="w-full bg-zinc-500 h-32 rounded-lg overflow-hidden" >
                  <img class="w-full h-full object-cover" src="<%= user.image %>" alt="">
                </div>
                <h3 class="text-s mt-2 tracking-tighter"><%= user.name %></h3>
                <h5 class="text-zinc-500 tracking-tighter"><%= user.email %></h5>
                <div class="mt-5 flex gap-7 flex-wrap">
                    <a href="/edit/<%= user._id %>" class="text-zinc-500">Edit User</a>
                    <a href="/delete/<%= user._id %>" mx-2 class="text-red-500">Delete User</a>
                </div>
                </div>
            <% }) %>
            <% } else { %>
                <h3 class="text-zinc-500">No User</h3>
            <% } %>
       </div>
       
    </div>
</body>
</html>